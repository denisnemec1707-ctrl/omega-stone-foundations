# =============================================================================
# Webhook URLs — Zapier "Catch Hook" triggers, one per form.
# Copy this file to `.env.local` (for dev) and set the same values in Vercel
# Production env (Settings → Environment Variables) for prod.
#
# Each Zap should:
#   1. Trigger:  Webhooks by Zapier → Catch Hook
#   2. Action:   Google Sheets → Create Spreadsheet Row
#                (in spreadsheet "ASSETRA Webstránka – Leady", appropriate sheet)
#   3. (optional) Slack/email notification, file upload to Drive for CV
# =============================================================================

# Paid landing pages
VITE_WEBHOOK_PREDAM_FIRMU=
VITE_WEBHOOK_INVESTOVAT=
VITE_WEBHOOK_FINANCOVANIE=
VITE_WEBHOOK_KLUB=

# Asistent CEO — multipart upload (form data + CV file)
# Zap should additionally have action: Google Drive → Upload File (cv field)
VITE_WEBHOOK_ASISTENT_CEO=

# Brand pages
VITE_WEBHOOK_INVESTOR_INQUIRY=
VITE_WEBHOOK_BRAND_CONTACT=
